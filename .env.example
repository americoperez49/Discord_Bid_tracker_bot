# --- Required ---
# Bot token from the Discord Developer Portal (Bot -> Reset Token)
DISCORD_TOKEN=your-bot-token-here
# Application (client) ID from General Information
CLIENT_ID=your-application-id-here

# --- Command registration ---
# Set GUILD_ID to register commands instantly to a single server (recommended for testing).
# Leave it blank to register commands globally (can take up to ~1 hour to appear).
GUILD_ID=your-test-server-id-here

# --- Optional ---
# Role ID that is allowed to run moderator commands (create/end/cancel/export).
# If unset, anyone with the "Manage Server" permission can use them.
MOD_ROLE_ID=

# Path to the SQLite database file. Defaults to ./data/auctions.sqlite
# DB_PATH=./data/auctions.sqlite

# --- HTTP API for Rogue App (optional) ---
# Off unless API_ENABLED=true. Every request needs BOTH the API key (X-Api-Key)
# and the signed-in user's Discord OAuth2 token (Authorization: Bearer ...).
# API_ENABLED=true
# Address to listen on. Keep 127.0.0.1 unless Rogue App runs on another machine,
# and then put it behind HTTPS (e.g. a reverse proxy) — never plain HTTP.
# API_HOST=127.0.0.1
# API_PORT=3000
# Shared secret, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# API_KEY=
# Rogue App's Discord application (client) ID. Tokens issued to any other app are rejected.
# ROGUE_APP_CLIENT_ID=
# The channel API-created auctions are posted in (the server's dedicated auction channel).
# AUCTION_CHANNEL_ID=

# --- rogue-cli (Rogue App stand-in for testing the API; not used by the bot) ---
# Can also go in a separate .env.rogue-cli. See "Testing the API with rogue-cli" in the README.
# ROGUE_APP_CLIENT_SECRET=
# ROGUE_APP_REDIRECT_URI=http://localhost:53134/callback
# ROGUE_CLI_API_URL=http://127.0.0.1:3000
# ROGUE_CLI_GUILD_ID=
